# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# Virtualenvs / env managers
.venv/
venv/
env/
.python-version

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Keel runtime artifacts (local-only, machine-specific, large)
# The serving profile + harness profile are machine-specific and regenerated by `keel setup`.
.keel/
*.keel-profile.json

# Models & weights — never commit (huge; downloaded locally)
models/
weights/
*.safetensors
*.gguf
*.mlx

# KV caches / local inference state
kv_cache/
*.kvcache

# Traces & eval outputs (large; regenerated by eval harness)
traces/
runs/
eval_results/
*.trace.jsonl
report.json

# Benchmark repos / datasets (fetched, not vendored)
datasets/
benchmarks/_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Secrets (there should be none for inference, but never commit any)
.env
.env.*
!.env.example

# Local-only: agent tooling config and internal planning (never published)
.claude/
CLAUDE.md
docs/ROADMAP.md
docs/overview.html
docs/*.pdf
